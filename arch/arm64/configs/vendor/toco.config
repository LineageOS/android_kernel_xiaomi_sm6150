# Camera
CONFIG_SOFTLED_CAMERA=y

# Device
CONFIG_MACH_XIAOMI_TOCO=y

# Disable stack frame warnings for LTO
CONFIG_FRAME_WARN=0

# Disable USB webcam driver (not needed, causes LTO warnings)
# CONFIG_USB_GSPCA is not set

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_FOD=y

# Haptics
CONFIG_INPUT_DRV260X_HAPTICS=y
# CONFIG_LEDS_QPNP_HAPTICS is not set
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# IR
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

# LED
CONFIG_LEDS_AW3644=y

# Power
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_ONEWIRE_GPIO=y
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX9886_F4=y
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_FTS_FOD_AREA_REPORT=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_TDDI_DBCLK=y

# Ultrasound proxmity
CONFIG_US_PROXIMITY=y

CONFIG_LLVM_POLLY=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_LD_LLD=y

CONFIG_LITTLE_CPU_MASK=63
CONFIG_BIG_CPU_MASK=192
CONFIG_PRIME_CPU_MASK=0

# CPU Governor
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# CPU Input Boost - Advanced event-based CPU boosting (Sultan Alsawaf)
# Replaces basic CPU_BOOST with better touch/wake boost control
# CONFIG_CPU_BOOST is not set
CONFIG_CPU_INPUT_BOOST=y
CONFIG_INPUT_BOOST_DURATION_MS=150
CONFIG_WAKE_BOOST_DURATION_MS=1000
# Input boost frequencies - increased for lower input latency
CONFIG_INPUT_BOOST_FREQ_LP=1516800
CONFIG_INPUT_BOOST_FREQ_PERF=1804800
# Max boost frequencies (wake/frame render)
CONFIG_MAX_BOOST_FREQ_LP=1708800
CONFIG_MAX_BOOST_FREQ_PERF=2016000

### Scheduler
# WALT (Window Assisted Load Tracking) for better CPU-GPU coordination
CONFIG_SCHED_WALT=y

### Timer Frequency
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
CONFIG_HZ_300=y
# CONFIG_HZ_1000 is not set

### I/O
# Enable blk-mq for SCSI/UFS - Required for MQ schedulers like ADIOS
CONFIG_SCSI_MQ_DEFAULT=y

CONFIG_IOSCHED_NOOP=y
CONFIG_DEFAULT_NOOP=y
CONFIG_DEFAULT_IOSCHED="noop"

# ADIOS - Adaptive Deadline I/O Scheduler (MQ scheduler with latency learning)
# Selectable via: echo adios > /sys/block/sda/queue/scheduler
CONFIG_MQ_IOSCHED_ADIOS=y

# Sbalance para toco
CONFIG_IRQ_SBALANCE=y
CONFIG_IRQ_SBALANCE_POLL_MSEC=3000
CONFIG_IRQ_SBALANCE_THRESH=1024
CONFIG_SBALANCE_EXCLUDE_CPUS="6,7"

# ZRAM Multi-Compression (Backported from kernel 6.2)
# Primary: LZ4 (fast), Secondary: ZSTD (better ratio for idle pages)
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZRAM_MULTI_COMP=y

# Memory Management
# MEMCG is required for MGLRU to work properly
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
# PSI required for lmkd to start (Android 10+ requires it for boot)
# lmkd uses PSI for memory pressure detection - official Google solution
CONFIG_PSI=y
# Note: Simple LMK (Sultan) is NOT compatible with MEMCG
# Since MGLRU requires MEMCG, we use lmkd+PSI instead (same as Pixel devices)

# MGLRU - Multi-Generational LRU (Backported from kernel 6.1)
# Superior page reclaim algorithm with better app retention
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Disable UKSM - MGLRU handles memory more efficiently
# CONFIG_KSM is not set
# CONFIG_UKSM is not set

CONFIG_SCHED_CASS=y

### Network Optimizations
# TCP BBR congestion control for better mobile network performance
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Increase network buffer sizes
CONFIG_NET_RX_BUSY_POLL=y

### Performance Tweaks
# Disable debug features for production performance
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_BUGVERBOSE is not set

# Enable additional optimizations
CONFIG_JUMP_LABEL=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

CONFIG_OVERLAY_FS=y

# EROFS (Enhanced Read-Only File System) for Android 12+
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
# CONFIG_KPROBES is not set
CONFIG_KSU=y
# CONFIG_KSU_KPROBES_HOOK is not set

# SUSFS Configuration for KernelSU
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
# CONFIG_KSU_SUSFS_SUS_OVERLAYFS is not set
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# Realtime torch brightness control
CONFIG_LEDS_QPNP_FLASH_V2_TORCH_BRIGHTNESS=y

CONFIG_SCHED_BORE=y

# Thermal - Power Allocator for smarter thermal management
# Uses IPA (Intelligent Power Allocation) algorithm
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y

# SchedTune - Per-task group performance boosting
# Allows fine-grained boost control for foreground/background tasks
CONFIG_SCHED_TUNE=y

# Devfreq Boost - DDR bandwidth boost on input/wake events
CONFIG_DEVFREQ_BOOST=y
CONFIG_DEVFREQ_INPUT_BOOST_DURATION_MS=100
CONFIG_DEVFREQ_WAKE_BOOST_DURATION_MS=1000
# DDR boost freq: 1555 MHz * 4 bytes = 5931 MB/s (high but not max)
CONFIG_DEVFREQ_CPU_LLCC_DDR_BW_BOOST_FREQ=5931

# SM6150 Performance Monitor - Tensor AIO concepts for Snapdragon 730G
# Real freq measurement, throttle detection, DDR/L3 quiescence
CONFIG_SM6150_PERFMON=y